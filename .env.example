# Copier en .env.local pour le développement, et définir ces variables dans
# Vercel (Project Settings -> Environment Variables) pour la production.
#
# Toutes les variables VITE_* sont injectées dans le bundle client : elles sont
# donc PUBLIQUES. Ne jamais y mettre de clé secrète, de token ou de mot de passe.

# URL canonique du site en production, sans slash final.
# Utilisée pour les balises canonical, Open Graph, robots.txt et sitemap.xml.
VITE_SITE_URL=https://rylix.ch

# Identifiant du formulaire Formspree — la partie après /f/ dans l'endpoint
# https://formspree.io/f/xxxxxxx. Identifiant public, pas un secret.
# Tant qu'il n'est pas défini, la page /contact affiche un message à la place
# du formulaire.
VITE_FORMSPREE_ID=

# Adresse de contact affichée en complément du formulaire. Optionnelle.
VITE_CONTACT_EMAIL=
